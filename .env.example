# General
TZ=Europe/Lisbon
PUID=1000
PGID=1000

# Paths
MUSIC_PATH=/srv/docker/gusonic/music
NAVIDROME_DATA_PATH=/srv/docker/gusonic/navidrome/data
OCTO_CONFIG_PATH=/srv/docker/gusonic/octo/config
SLSKD_CONFIG_PATH=/srv/docker/gusonic/slskd
LIDARR_CONFIG_PATH=/srv/docker/gusonic/lidarr/config
LIDARR_DOWNLOADS_PATH=/srv/docker/gusonic/lidarr/downloads

# Octo
DOWNLOAD_SOURCE=Soulseek
FOLDER_STRUCTURE=Flat
METADATA_LANGUAGE=es

# Last.fm
LASTFM_API_KEY=

# slskd web/API credentials used by Octo
SLSKD_USERNAME=slskd
SLSKD_PASSWORD=

# Soulseek network account
SOULSEEK_USERNAME=
SOULSEEK_PASSWORD=

# Lidarr
LIDARR_API_KEY=
LIDARR_QUALITY_PROFILE_ID=0
LIDARR_METADATA_PROFILE_ID=0
LIDARR_COMPLETION_MODE=Accepted
LIDARR_IMPORT_TIMEOUT_SECONDS=1800
